# Copy to .env.local and fill in. See README.md for how to create these in Google Cloud Console.

# OAuth client of type "Web application" (used by the browser build).
VITE_GOOGLE_WEB_CLIENT_ID=

# OAuth client of type "Desktop app" (used by the Tauri build). Google doesn't treat
# installed-app client secrets as confidential, but keep .env.local out of git anyway.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=

# Scheduling server the desktop build talks to (the web build uses its own origin).
VITE_API_URL=https://calendar.bayfield.dev

# Optional: Google Places autocomplete for locations (enable "Places API (New)" and restrict the key
# to your origins). Without it, place suggestions come from OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=
