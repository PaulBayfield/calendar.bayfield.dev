{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calendar",
  "version": "../package.json",
  "identifier": "dev.bayfield.calendar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Calendar",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCQjU0RkY4NzExNTg4OTgKUldTWWlCVngrRSsxNnhIWkZaTHpMTnpwbHhQcW1FNkZJOWpJMWcwUDczNU5NV0Q2a3lkWVo1RWYK",
      "endpoints": [
        "https://github.com/PaulBayfield/calendar.bayfield.dev/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
