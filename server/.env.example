# Copy to server/.env for local runs, or pass these to the container.

# Where the server is reachable from the internet (used for booking links and the OAuth redirect).
PUBLIC_URL=https://calendar.bayfield.dev
PORT=8787

# Only this Google account can create links / connect the server.
OWNER_EMAIL=you@gmail.com
# Shown on booking pages.
OWNER_NAME=Your Name

# The "Web application" OAuth client. Add this redirect URI to it in Google Cloud Console:
#   ${PUBLIC_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The "Desktop app" client ID, so the desktop build can call the API too.
GOOGLE_DESKTOP_CLIENT_ID=

# SQLite lives here (mount a volume on it in Docker).
DATA_DIR=./data
# Extra origins allowed to call the API (defaults cover the Tauri app and the Vite dev server).
# CORS_ORIGINS=http://localhost:1420,http://tauri.localhost
